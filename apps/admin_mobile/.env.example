# Flutter build-time configuration (public values only)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secrets — configure in Supabase Edge Function secrets, never in Flutter:
# RESEND_API_KEY=
# OTP_FROM_EMAIL=admin@your-verified-domain.example
# OTP_PEPPER=
# SUPABASE_SERVICE_ROLE_KEY=
