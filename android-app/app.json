{
  "expo": {
    "name": "SuksesCPNS",
    "slug": "suksescpns",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "suksescpns",
    "plugins": [
      "expo-router"
    ],
    "android": {
      "package": "com.suksescpns.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "suksescpns"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    }
  }
}
